<Window x:Class="KeyboardAnalogThrottle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Analog Throttle"
        Width="760"
        Height="680"
        MinWidth="620"
        MinHeight="520">
    <TabControl Margin="16" KeyboardNavigation.TabNavigation="Cycle">
        <TabItem Header="Dashboard">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Keyboard Analog Throttle" />

                    <Border Grid.Row="1" Margin="0,16,0,0" Padding="16" Background="#FFF2F4F7" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Status}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding StatusMessage}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding IsKeyboardHookConnected, StringFormat=Keyboard hook connected: {0}}" />
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding IsControllerConnected, StringFormat=Controller connected: {0}}" />
                                <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding VigemBusAvailability, StringFormat=ViGEmBus: {0}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="16" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Throttle" />
                                <TextBlock Margin="0,8,0,2" Text="Raw input" />
                                <ProgressBar Height="18" Maximum="100" Value="{Binding RawThrottlePercentage, Mode=OneWay}" AutomationProperties.Name="Raw throttle input" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding RawThrottlePercentage, StringFormat={}{0:F1}%}" />
                                <TextBlock Margin="0,8,0,2" Text="Controller output" />
                                <ProgressBar Height="18" Maximum="100" Value="{Binding ThrottlePercentage, Mode=OneWay}" AutomationProperties.Name="Throttle controller output" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding ThrottlePercentage, StringFormat={}{0:F1}%}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" BorderBrush="#FFD0D7DE" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Brake" />
                                <TextBlock Margin="0,8,0,2" Text="Raw input" />
                                <ProgressBar Height="18" Maximum="100" Value="{Binding RawBrakePercentage, Mode=OneWay}" AutomationProperties.Name="Raw brake input" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding RawBrakePercentage, StringFormat={}{0:F1}%}" />
                                <TextBlock Margin="0,8,0,2" Text="Controller output" />
                                <ProgressBar Height="18" Maximum="100" Value="{Binding BrakePercentage, Mode=OneWay}" AutomationProperties.Name="Brake controller output" />
                                <TextBlock HorizontalAlignment="Right" Text="{Binding BrakePercentage, StringFormat={}{0:F1}%}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <TextBlock FontWeight="SemiBold" Text="Current operation" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding ControllerTestStep}" />
                        <TextBlock Margin="0,8,0,0" Foreground="#FFB00020" TextWrapping="Wrap" Text="{Binding LastError}" AutomationProperties.Name="Last error" />
                    </StackPanel>

                    <Expander Grid.Row="4" Margin="0,16,0,0" Header="Diagnostics" IsExpanded="False">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="0,0,16,8" FontWeight="SemiBold" Text="Input health" />
                            <TextBlock Grid.Column="1" Margin="0,0,0,8" Text="{Binding InputHealth}" />
                            <TextBlock Grid.Row="1" Margin="0,0,16,8" FontWeight="SemiBold" Text="Mapped keys" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding ActiveBindings}" />
                            <TextBlock Grid.Row="2" Margin="0,0,16,0" FontWeight="SemiBold" Text="Key suppression" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IsSuppressionEnabled, StringFormat=Enabled: {0}}" />
                            <TextBlock Grid.Row="3" Margin="0,8,16,0" FontWeight="SemiBold" Text="Throttle cut" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding IsThrottleCutActive, StringFormat=Active: {0}}" />
                        </Grid>
                    </Expander>

                    <WrapPanel Grid.Row="5" Margin="0,20,0,0" HorizontalAlignment="Right" ItemHeight="32">
                        <Button Margin="4" Padding="12,4" Command="{Binding StartCommand}" Content="Start" />
                        <Button Margin="4" Padding="12,4" Command="{Binding StopCommand}" Content="Stop" />
                        <Button Margin="4" Padding="12,4" Command="{Binding EmergencyStopCommand}" Content="Emergency reset" />
                        <Button Margin="4" Padding="12,4" Command="{Binding ReloadConfigurationCommand}" Content="Reload configuration" />
                        <Button Margin="4" Padding="12,4" Command="{Binding OpenConfigurationFileCommand}" Content="Open config file" />
                        <Button Margin="4" Padding="12,4" Command="{Binding OpenConfigurationFolderCommand}" Content="Open config folder" />
                        <Button Margin="4" Padding="12,4" Command="{Binding TestControllerCommand}" Content="Test controller" />
                        <Button Margin="4" Padding="12,4" Command="{Binding ExitCommand}" Content="Exit" />
                    </WrapPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Shortcuts">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Shortcut editor" />
                    <TextBlock Margin="0,4,0,16" TextWrapping="Wrap" Text="Changes apply after Save shortcuts." />

                    <GroupBox Header="Throttle">
                        <StackPanel Margin="12">
                            <TextBlock Text="Primary key" />
                            <TextBox Margin="0,2,0,12" Text="{Binding ShortcutEditor.ThrottlePrimaryBinding, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Fixed levels" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ShortcutEditor.ThrottleFixedLevels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Level, StringFormat={}{0:P0}}" />
                                            <TextBox Grid.Column="1" Text="{Binding Binding, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,16,0,0" Header="Brake">
                        <StackPanel Margin="12">
                            <TextBlock Text="Primary key" />
                            <TextBox Margin="0,2,0,12" Text="{Binding ShortcutEditor.BrakePrimaryBinding, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Fixed levels" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ShortcutEditor.BrakeFixedLevels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Text="{Binding Level, StringFormat={}{0:P0}}" />
                                            <TextBox Grid.Column="1" Text="{Binding Binding, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,16,0,0" Header="Safety">
                        <StackPanel Margin="12">
                            <TextBlock Text="Throttle cut" />
                            <TextBox Margin="0,2,0,12" Text="{Binding ShortcutEditor.ThrottleCutBinding, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Emergency disable" />
                            <TextBox Margin="0,2,0,0" Text="{Binding ShortcutEditor.EmergencyDisableBinding, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Margin="0,16,0,0" Header="Ratchet">
                        <StackPanel Margin="12">
                            <TextBlock Text="Increase" />
                            <TextBox Margin="0,2,0,12" Text="{Binding ShortcutEditor.RatchetIncreaseBinding, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Decrease" />
                            <TextBox Margin="0,2,0,12" Text="{Binding ShortcutEditor.RatchetDecreaseBinding, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Reset" />
                            <TextBox Margin="0,2,0,0" Text="{Binding ShortcutEditor.RatchetResetBinding, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <Button Margin="0,20,0,0" Padding="12,6" HorizontalAlignment="Right" Command="{Binding SaveShortcutsCommand}" Content="Save shortcuts" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
